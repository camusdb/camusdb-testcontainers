<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>CamusDB.Testcontainers</RootNamespace>
    <PackageId>CamusDB.Testcontainers</PackageId>
    <Description>Testcontainers module for CamusDB: starts a throwaway CamusDB server in Docker for integration tests and exposes its HTTP and gRPC endpoints.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CamusDB.Testcontainers.Tests" />
  </ItemGroup>

</Project>
